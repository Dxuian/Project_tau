#!/usr/bin/env bash
# Host entry point for cpuminer-opt-js. It only calls `docker compose`;
# every build, test and tool runs inside the containers in docker-compose.yml.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<'EOF'
usage: ./dev <command> [args]

  setup          build the Docker images and install dev dependencies
  vendor         copy pinned cpuminer-opt sources from ../cpuminer-opt
  wasm [args]    compile the WASM variants (scripts/build-wasm.mjs)
  golden         build+run the native reference harness (amd64 and arm64)
  build          build dist/ (embeds the WASM, bundles workers)
  test           run the Node test suite
  test:browser   run the headless Chromium tests
  bench [args]   cpuminer-js --benchmark (from dist/); --all: per-algo variant prefs
  audit          re-run the dependency checks recorded in AUDIT.md
  shell [cmd]    open a shell (or run cmd) in the dev container
  clean [--all]  remove build outputs (--all: also images and volumes)
EOF
}

if ! docker info >/dev/null 2>&1; then
  echo "Docker isn't reachable. Start Docker Desktop, then retry." >&2
  exit 1
fi

tty_flag=()
if [ ! -t 0 ] || [ ! -t 1 ]; then tty_flag=(-T); fi
run() { docker compose run --rm "${tty_flag[@]}" "$@"; }

check_memory() {
  local mem
  mem=$(docker info --format '{{.MemTotal}}')
  if [ "$mem" -lt $((6 * 1024 * 1024 * 1024)) ]; then
    echo "Docker Desktop has $((mem / 1024 / 1024)) MiB of memory; the verthash test needs about 6 GiB." >&2
    echo "Raise it under Docker Desktop > Settings > Resources, then retry." >&2
    exit 1
  fi
}

cmd="${1:-help}"
shift || true
case "$cmd" in
  setup)
    docker compose build
    run dev npm ci --ignore-scripts
    ;;
  vendor)       run dev node scripts/vendor.mjs "$@" ;;
  wasm)         run dev node scripts/build-wasm.mjs "$@" ;;
  golden)
    check_memory
    run dev node scripts/prepare-src.mjs
    # arm64 first: it runs natively and creates the verthash dataset in the
    # shared cache volume, which the (emulated) amd64 reference then reuses.
    run dev bash scripts/golden.sh
    run ref-amd64 bash scripts/golden.sh
    run ref-amd64 bash scripts/golden.sh avx2
    ;;
  build)        run dev npm run build ;;
  test)         check_memory; run dev npm test -- "$@" ;;
  test:browser) run dev npm run test:browser -- "$@" ;;
  bench)
    if [ "${1:-}" = "--all" ]; then run dev node scripts/variant-prefs.mjs
    else run dev node dist/cli.js --benchmark "$@"; fi
    ;;
  audit)        run dev node scripts/audit.mjs "$@" ;;
  shell)
    if [ $# -eq 0 ]; then run dev bash; else run dev "$@"; fi
    ;;
  clean)
    run dev rm -rf dist native/out
    if [ "${1:-}" = "--all" ]; then
      docker compose down --rmi local --volumes
    fi
    ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
