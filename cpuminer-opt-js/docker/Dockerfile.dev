# syntax=docker/dockerfile:1
# Dev image: Emscripten (WASM builds), Node (build/tests), GCC + libgmp
# (arm64 reference harness), GMP compiled to WASM (m7m), headless Chromium.
ARG EMSDK_VERSION=6.0.13
FROM emscripten/emsdk:${EMSDK_VERSION}

ARG NODE_VERSION=26.13.0
ARG PLAYWRIGHT_VERSION=1.64.1
ARG GMP_VERSION=6.3.0
# Same digest from ftp.gnu.org and gmplib.org (GMP publishes only GPG signatures).
ARG GMP_SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential libgmp-dev m4 xz-utils ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

# Node, verified against the release's published SHASUMS256.txt.
RUN set -eux; \
    case "$(dpkg --print-architecture)" in \
      arm64) plat=linux-arm64 ;; amd64) plat=linux-x64 ;; \
      *) echo "unsupported arch" >&2; exit 1 ;; \
    esac; \
    cd /tmp; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-${plat}.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt"; \
    grep " node-v${NODE_VERSION}-${plat}.tar.xz\$" SHASUMS256.txt | sha256sum -c -; \
    mkdir -p /opt/node; \
    tar -xJf "node-v${NODE_VERSION}-${plat}.tar.xz" -C /opt/node --strip-components=1; \
    rm -f node-*.tar.xz SHASUMS256.txt
ENV PATH=/opt/node/bin:$PATH

# GMP compiled to WASM (generic C, 32-bit limbs) for the m7m algorithm.
RUN set -eux; \
    test -n "${GMP_SHA256}"; \
    cd /tmp; \
    curl -fsSLO "https://ftp.gnu.org/gnu/gmp/gmp-${GMP_VERSION}.tar.xz"; \
    echo "${GMP_SHA256}  gmp-${GMP_VERSION}.tar.xz" | sha256sum -c -; \
    tar -xJf "gmp-${GMP_VERSION}.tar.xz"; \
    cd "gmp-${GMP_VERSION}"; \
    emconfigure ./configure --host=none --disable-assembly --disable-shared \
      --enable-static --disable-cxx --prefix=/opt/gmp-wasm \
      CFLAGS="-O3" CC_FOR_BUILD=gcc; \
    emmake make -j"$(nproc)"; \
    emmake make install; \
    cd /; rm -rf /tmp/gmp-*

# Headless Chromium for the browser tests (matches the playwright-core devDependency).
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx -y "playwright@${PLAYWRIGHT_VERSION}" install --with-deps chromium \
 && rm -rf /var/lib/apt/lists/* /root/.npm

WORKDIR /src
