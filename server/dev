#!/usr/bin/env bash
# Host entry point for server/. It only calls `docker compose` (with the
# repository's docker-compose.yml); installs, builds and tests run inside the
# containers, with server/ as the working directory.
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  cat <<'USAGE'
usage: server/dev <command> [args]

  setup          build the regtest bitcoind image and install dependencies
  test [files]   run the tests (starts a fresh private regtest bitcoind and a local TiDB); files as test/x.test.js
  db generate [name]  after editing tidb/schema.js or cloudflare/schema.js: write the next migrations (drizzle-kit)
  db migrate     apply the TiDB migrations to your TiDB Cloud database (DB_PASSWORD from your environment)
  bundle         bundle cloudflare/worker.js as `wrangler deploy` would (into server/.wrangler/bundle)
  site build     build the website (site/) for Node and Vercel (next build)
  site cf-build  build the website for Cloudflare Workers (OpenNext, into site/.open-next)
  shell [cmd]    open a shell (or run cmd) in the app container, in server/
  down           stop the regtest bitcoind

The library's own commands (build, its tests, the dependency audit) are in
tau-crypto/dev.
USAGE
}

if ! docker info >/dev/null 2>&1; then
  echo "Docker isn't reachable. Start Docker, then retry." >&2
  exit 1
fi
if ! docker image inspect tau-crypto-dev:local >/dev/null 2>&1; then
  echo "Missing image tau-crypto-dev:local: run tau-crypto/dev setup first." >&2
  exit 1
fi

tty_flag=()
if [ ! -t 0 ] || [ ! -t 1 ]; then tty_flag=(-T); fi
# ${a[@]+"${a[@]}"}: an empty array is "unbound" to set -u in macOS bash 3.2.
run() { docker compose run --rm ${tty_flag[@]+"${tty_flag[@]}"} "$@"; }

cmd="${1:-help}"
shift || true
case "$cmd" in
  setup)
    docker compose build bitcoind
    run app npm ci --ignore-scripts
    run app sh -c "cd site && npm ci --ignore-scripts"
    ;;
  test)
    docker compose up -d --force-recreate bitcoind tidb
    trap 'docker compose stop bitcoind tidb >/dev/null 2>&1 || true' EXIT
    if [ $# -eq 0 ]; then run app npm test; else run app node --test --test-concurrency=1 "$@"; fi
    ;;
  db)
    case "${1:-}" in
      generate)
        name=()
        if [ -n "${2:-}" ]; then name=(--name "$2"); fi
        for config in tidb/drizzle.config.js cloudflare/drizzle.config.js; do
          run app npx drizzle-kit generate --config "$config" ${name[@]+"${name[@]}"}
        done
        ;;
      migrate)
        if [ -z "${DB_PASSWORD:-}" ]; then
          echo "Set DB_PASSWORD to your TiDB Cloud connection string first (it stays in your environment)." >&2
          exit 1
        fi
        run -e DB_PASSWORD -e TAU_DB_NAME app npm run db:migrate
        ;;
      *) usage; exit 1 ;;
    esac
    ;;
  bundle)       run app npx wrangler deploy --dry-run --config cloudflare/wrangler.toml --outdir /repo/server/.wrangler/bundle ;;
  site)
    case "${1:-}" in
      build)    run app sh -c "cd site && npm run build" ;;
      cf-build) run app sh -c "cd site && npm run cf:build" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  shell)
    if [ $# -eq 0 ]; then run app bash; else run app "$@"; fi
    ;;
  down)         docker compose down ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
