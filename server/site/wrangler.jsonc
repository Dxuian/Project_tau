// The site as a Cloudflare Worker (OpenNext). From site/, with your own account:
//   npm run cf:build     builds .open-next/
//   npm run cf:deploy    deploys it
// Or connect the repo in the Cloudflare dashboard (Workers Builds) as the Worker
// tau-site: root directory server/site, build command
// npm ci --ignore-scripts && npm run cf:build, deploy command npm run cf:deploy.
// The vars point at the payout Worker (server/cloudflare, project-tau): its URL
// serves the payout API, and the same host takes the miners' WebSockets.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tau-site",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-30",
  // global_fetch_strictly_public: the payout Worker is on the same workers.dev
  // subdomain, and Cloudflare refuses fetches from one Worker to another there
  // (error 1042) unless they go out as public requests.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Served on tau-site.deathxunnat.workers.dev only, without per-version preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "vars": {
    "PAYOUT_API_URL": "https://project-tau.deathxunnat.workers.dev",
    "BRIDGE_URL": "wss://project-tau.deathxunnat.workers.dev",
    "POOL_URL": "stratum+tcp://solo.ckpool.org:3333",
    "NETWORK": "mainnet"
  }
}
