#!/usr/bin/env bash
# Host entry point for the top-level project. It only calls `docker compose`;
# installs, builds and tests run inside the containers in docker-compose.yml.
set -euo pipefail
cd "$(dirname "$0")"

usage() {
  cat <<'USAGE'
usage: ./dev <command> [args]

  setup          build the regtest bitcoind image and install dependencies
  test [files]   run the tests (starts a fresh private regtest bitcoind)
  bundle         bundle server/cloudflare/worker.js as `wrangler deploy` would (into .wrangler/bundle)
  site build     build the website (site/) for Node and Vercel (next build)
  site cf-build  build the website for Cloudflare Workers (OpenNext, into site/.open-next)
  shell [cmd]    open a shell (or run cmd) in the app container
  down           stop the regtest bitcoind

The library's own commands (build, its tests, the dependency audit) are in
tau-crypto/dev.
USAGE
}

if ! docker info >/dev/null 2>&1; then
  echo "Docker isn't reachable. Start Docker, then retry." >&2
  exit 1
fi
if ! docker image inspect tau-crypto-dev:local >/dev/null 2>&1; then
  echo "Missing image tau-crypto-dev:local: run tau-crypto/dev setup first." >&2
  exit 1
fi

tty_flag=()
if [ ! -t 0 ] || [ ! -t 1 ]; then tty_flag=(-T); fi
run() { docker compose run --rm "${tty_flag[@]}" "$@"; }

cmd="${1:-help}"
shift || true
case "$cmd" in
  setup)
    docker compose build bitcoind
    run app npm ci --ignore-scripts
    run app sh -c "cd site && npm ci --ignore-scripts"
    ;;
  test)
    docker compose up -d --force-recreate bitcoind
    trap 'docker compose stop bitcoind >/dev/null 2>&1 || true' EXIT
    if [ $# -eq 0 ]; then run app npm test; else run app node --test --test-concurrency=1 "$@"; fi
    ;;
  bundle)       run app npx wrangler deploy --dry-run --config server/cloudflare/wrangler.toml --outdir /repo/.wrangler/bundle ;;
  site)
    case "${1:-}" in
      build)    run app sh -c "cd site && npm run build" ;;
      cf-build) run app sh -c "cd site && npm run cf:build" ;;
      *) usage; exit 1 ;;
    esac
    ;;
  shell)
    if [ $# -eq 0 ]; then run app bash; else run app "$@"; fi
    ;;
  down)         docker compose down ;;
  help|-h|--help) usage ;;
  *) usage; exit 1 ;;
esac
